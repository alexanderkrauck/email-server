# Copy to .env and edit. Fill in only the block for the compose file you use.
# Generate every secret with:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# docker-compose.yml — local trial, loopback only, no authentication
# ---------------------------------------------------------------------------
EMAILSERVER_AUTH_MODE=development


# ---------------------------------------------------------------------------
# docker-compose.single-user.yml — one owner, static bearer token, HTTPS
# ---------------------------------------------------------------------------
# EMAILSERVER_DOMAIN=mail.example.com
# POSTGRES_PASSWORD=replace-me
# EMAILSERVER_API_TOKEN=replace-me          # at least 32 characters
# CREDENTIAL_ENCRYPTION_KEY=replace-me
# SESSION_SECRET=replace-me
#
# Optional, and only to connect Gmail mailboxes by OAuth instead of an app
# password. Unrelated to how you sign in to this server.
# GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me


# ---------------------------------------------------------------------------
# docker-compose.production.yml — multiple users, Google OAuth, HTTPS
# ---------------------------------------------------------------------------
# EMAILSERVER_DOMAIN=mail.example.com
# POSTGRES_PASSWORD=replace-me
# GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# JWT_SIGNING_KEY=replace-me
# CREDENTIAL_ENCRYPTION_KEY=replace-me
# SESSION_SECRET=replace-me
# REGISTRATION_MODE=allowlist
# ALLOWED_GOOGLE_EMAILS=["owner@example.com"]
# ALLOWED_GOOGLE_SUBJECTS=[]
# CLAIM_LEGACY_ACCOUNTS_ON_FIRST_LOGIN=false


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# OCR languages for image attachments. Empty uses every language installed in
# the image (eng deu fra ita spa nld por by default), which is what mixed
# language mailboxes need. Pin a subset to make extraction faster.
# EMAILSERVER_OCR_LANGUAGES=deu+eng
